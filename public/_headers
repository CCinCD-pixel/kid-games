# Netlify headers for dist/. This file is the static part; the build (vite.config.ts →
# tools/registry.mjs buildHeaders) appends a "Cache-Control: no-cache" rule for every HTML page
# and the manifest, so a deploy shows up on the next launch. Audio/models/fonts keep Netlify's
# default (max-age=0, must-revalidate + ETag: unchanged files cost a 304) and are cached offline by
# the service worker's content-addressed media cache.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Vite's content-hashed bundles never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
