{
 "version": 1,
 "_doc": "Playback policy for content/memory-matrix/narration.yaml (the voice pipeline does not know these fields). Enforced by src/core/voice.ts; narration-lint.mjs checks every id exists. Fields: night1 = only the first round of a night; onRuleChange; afterAwayMin; whenChanged; maxPerRound/maxPerNight/maxPerSession/maxPerWeek; cooldownRounds/cooldownNights; onlyOnPass; drop = discard (never queue) when the narrator is busy.",
 "queue": {
  "default": "queue in order; prompts and instructions are never dropped",
  "interrupt": [
   "再听一遍 (replays the last prompt)",
   "跳过",
   "🏠",
   "the next action button"
  ],
  "dropIfBusy": [
   "mm.fb.ok*",
   "mm.fb.slip*",
   "mm.fb.hint0",
   "mm.res.*",
   "mm.fb.up",
   "mm.fb.down"
  ],
  "neverSpeakDuring": [
   "show",
   "fog"
  ],
  "silenceBeforeDisplayMs": 300,
  "hintsVsPrompt": "hint lines (H2/H3/tips) wait for the current line to end; a tap on the board never cuts a line, only 跳过 / 再听一遍 / 🏠 do"
 },
