{
 "fort.dock.1": {
  "role": "companion",
  "kind": "talk",
  "text": "两千多年前，有一位叫墨子的科学家。"
 },
 "fort.dock.2": {
  "role": "companion",
  "kind": "talk",
  "text": "2016年，中国把量子卫星叫作墨子号。",
  "norm": "二零一六年，中国把量子卫星叫作墨子号。"
 },
 "fort.dock.3": {
  "role": "companion",
  "kind": "talk",
  "text": "走，我们去见见墨子！"
 },
 "fort.dock.v1": {
  "role": "companion",
  "kind": "talk",
  "text": "墨子号卫星，就是用他的名字命名的。"
 },
 "fort.dock.v2": {
  "role": "companion",
  "kind": "talk",
  "text": "第二卷推演完成！你守住了十天十夜。"
 },
 "fort.story.0.1": {
  "role": "narrator",
  "kind": "talk",
  "text": "很久以前，楚王想去攻打小小的宋国。"
 },
 "fort.story.0.2": {
  "role": "narrator",
  "kind": "talk",
  "text": "鲁班为楚王造好了高高的云梯。"
 },
 "fort.story.0.3": {
  "role": "narrator",
  "kind": "card",
  "text": "墨子带着最小的弟子小步步，出发去劝楚王。"
 },
 "fort.story.0.3.plain": {
  "role": "narrator",
  "kind": "card",
  "text": "墨子带着最小的弟子，出发去劝楚王。",
  "plain": true
 },
 "fort.story.0.4": {
  "role": "luban",
  "kind": "talk",
  "text": "墨子先生，先赢了我的机关沙盘再说！"
 },
 "fort.story.0.5": {
  "role": "dad",
  "kind": "talk",
  "text": "好。沙盘上分出胜负，真仗就不用打了。"
 },
 "fort.story.1.end.1": {
  "role": "narrator",
  "kind": "talk",
  "text": "铜犀冲车被拆开了。"
 },
 "fort.story.1.end.2": {
  "role": "luban",
  "kind": "talk",
  "text": "好铜！做成一把犁，去翻地吧！"
 },
 "fort.story.1.end.3": {
  "role": "narrator",
  "kind": "talk",
  "text": "宋城外的粟田，又犁开了一块。"
 },
 "fort.story.2.open.1": {
  "role": "narrator",
  "kind": "talk",
  "text": "墨子赶路去楚国，走了十天十夜。"
 },
 "fort.story.2.open.2": {
  "role": "dad",
  "kind": "talk",
  "text": "夜里没人送粮。点起篝火，接着推演。"
 },
 "fort.story.2.end.1": {
  "role": "narrator",
  "kind": "talk",
  "text": "夜枭木鸢收起翅膀，折成了一只风筝。"
 },
 "fort.story.2.end.2": {
  "role": "luban",
  "kind": "talk",
  "text": "天亮了！这只木鸟，送给孩子们放吧。"
 },
 "fort.story.2.end.3": {
  "role": "narrator",
  "kind": "talk",
  "text": "远处，楚国郢都的城墙出现了。"
 },
 "fort.lvl.1-1.1": {
  "role": "dad",
  "kind": "sub",
  "text": "鲁班的木甲兵要来了。"
 },
 "fort.lvl.1-1.2": {
  "role": "dad",
  "kind": "sub",
  "text": "把连弩车拖到第3路。",
  "norm": "把连弩车拖到第三路。"
 },
 "fort.lvl.1-2.1": {
  "role": "dad",
  "kind": "sub",
  "text": "先种禾田，粮会越来越多。"
 },
 "fort.lvl.1-2.2": {
  "role": "dad",
  "kind": "sub",
  "text": "再放连弩车守住来的路。"
 },
 "fort.lvl.1-3.1": {
  "role": "dad",
  "kind": "sub",
  "text": "木垒放在连弩车前面。"
 },
 "fort.lvl.1-3.2": {
  "role": "dad",
  "kind": "sub",
  "text": "木垒挡着，连弩车慢慢打。"
 },
 "fort.lvl.1-4.1": {
  "role": "dad",
  "kind": "sub",
  "text": "盾甲兵的木盾，箭打不穿。"
 },
 "fort.lvl.1-4.2": {
  "role": "dad",
  "kind": "sub",
  "text": "试试籍车，石头从天上落。"
 },
 "fort.lvl.1-5.1": {
  "role": "dad",
  "kind": "sub",
  "text": "冲车跑起来，撞得最狠。"
 },
 "fort.lvl.1-5.2": {
  "role": "dad",
  "kind": "sub",
  "text": "木垒前面铺上铁蒺藜。"
 },
 "fort.lvl.1-6.1": {
  "role": "dad",
  "kind": "sub",
  "text": "看鲁班的手按住哪一路。"
 },
 "fort.lvl.1-6.2": {
  "role": "dad",
  "kind": "sub",
  "text": "提前在那一路挖好陷坑。"
 },
 "fort.lvl.1-7.1": {
  "role": "dad",
  "kind": "sub",
  "text": "蚁傅一来就是一大群。"
 },
 "fort.lvl.1-7.2": {
  "role": "dad",
  "kind": "sub",
  "text": "火油罐，一罐烧一片。"
 },
 "fort.lvl.1-8.1": {
  "role": "dad",
  "kind": "sub",
  "text": "礌石很重，要留着用。"
 },
 "fort.lvl.1-8.2": {
  "role": "dad",
  "kind": "sub",
  "text": "等机关挤在一起再砸。"
 },
 "fort.lvl.1-9.1": {
  "role": "dad",
  "kind": "sub",
  "text": "铜甲力士不怕火。"
 },
 "fort.lvl.1-9.2": {
  "role": "dad",
  "kind": "sub",
  "text": "阳燧把阳光聚起来照它。"
 },
 "fort.lvl.1-10.1": {
  "role": "dad",
  "kind": "sub",
  "text": "这回你自己选牒。"
 },
 "fort.lvl.1-10.2": {
  "role": "dad",
  "kind": "sub",
  "text": "先看看鲁班亮了什么招。"
 },
 "fort.lvl.1-11.1": {
  "role": "dad",
  "kind": "sub",
  "text": "铜犀冲车来了！"
 },
 "fort.lvl.1-11.2": {
  "role": "dad",
  "kind": "sub",
  "text": "想想，什么敲得开铜壳？"
 },
 "fort.lvl.2-1.1": {
  "role": "dad",
  "kind": "sub",
  "text": "夜里没有人送粮。"
 },
 "fort.lvl.2-1.2": {
  "role": "dad",
  "kind": "sub",
  "text": "先建粮仓，粮会自己来。"
 },
 "fort.lvl.2-2.1": {
  "role": "dad",
  "kind": "sub",
  "text": "木鹊会飞去啄禾田。"
 },
 "fort.lvl.2-2.2": {
  "role": "dad",
  "kind": "sub",
  "text": "转射机打得到天上的。"
 },
 "fort.lvl.2-3.1": {
  "role": "dad",
  "kind": "sub",
  "text": "这回没有转射机。"
 },
 "fort.lvl.2-3.2": {
  "role": "dad",
  "kind": "sub",
  "text": "风箱能把木鹊吹下来。"
 },
 "fort.lvl.2-4.1": {
  "role": "dad",
  "kind": "sub",
  "text": "烟车会放烟。"
 },
 "fort.lvl.2-4.2": {
  "role": "dad",
  "kind": "sub",
  "text": "烟里的连弩车看不见。"
 },
 "fort.lvl.2-5.1": {
  "role": "dad",
  "kind": "sub",
  "text": "起大雾了，右边看不清。"
 },
 "fort.lvl.2-5.2": {
  "role": "dad",
  "kind": "sub",
  "text": "每一路都先放一台。"
 },
 "fort.lvl.2-6.1": {
  "role": "dad",
  "kind": "sub",
  "text": "云梯车会架梯子。"
 },
 "fort.lvl.2-6.2": {
  "role": "dad",
  "kind": "sub",
  "text": "钩拒能把梯子拉倒。"
 },
 "fort.lvl.2-7.1": {
  "role": "dad",
  "kind": "sub",
  "text": "急报！这回没有粮。"
 },
 "fort.lvl.2-7.2": {
  "role": "dad",
  "kind": "sub",
  "text": "牒片会自己送过来。"
 },
 "fort.lvl.2-8.1": {
  "role": "dad",
  "kind": "sub",
  "text": "鼓车一敲，机关都变快。"
 },
 "fort.lvl.2-8.2": {
  "role": "dad",
  "kind": "sub",
  "text": "先拆鼓车！"
 },
 "fort.lvl.2-9.1": {
  "role": "dad",
  "kind": "sub",
  "text": "烟、蚁群、冲车一起来。"
 },
 "fort.lvl.2-9.2": {
  "role": "dad",
  "kind": "sub",
  "text": "风箱和火油罐放一路。"
 },
 "fort.lvl.2-10.1": {
  "role": "dad",
  "kind": "sub",
  "text": "天快亮了，先守住夜里。"
 },
 "fort.lvl.2-10.2": {
  "role": "dad",
  "kind": "sub",
  "text": "天亮以后，阳燧就能用。"
 },
 "fort.lvl.2-11.1": {
  "role": "dad",
  "kind": "sub",
  "text": "夜枭木鸢飞得很高。"
 },
 "fort.lvl.2-11.2": {
  "role": "dad",
  "kind": "sub",
  "text": "看影子，它要俯冲了。"
 },
 "fort.lvl.1-1.collect": {
  "role": "dad",
  "kind": "sub",
  "text": "点一下粮包，粮就进粮斗。"
 },
 "fort.lvl.1-1.more": {
