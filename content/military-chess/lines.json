  "id": "mc.rule.7",
  "role": "narrator",
  "text": "军旗进大本营，地雷放后两排"
 },
 {
  "id": "mc.rule.8",
  "role": "narrator",
  "text": "翻翻棋：翻开定颜色，挖光地雷才扛旗"
 },
 {
  "id": "mc.card.rail",
  "role": "narrator",
  "text": "真正的高铁一小时能跑三百多公里。"
 },
 {
  "id": "mc.card.engineer",
  "role": "narrator",
  "text": "工兵会修桥、修路，帮大家清除危险。"
 },
 {
  "id": "mc.card.flag",
  "role": "narrator",
  "text": "军旗代表一支队伍，大家一起守护它。"
 },
 {
  "id": "mc.card.camp",
  "role": "narrator",
  "text": "行营是休整的地方，在棋里谁也打不到。"
 },
 {
  "id": "mc.card.hq",
  "role": "narrator",
  "text": "大本营是指挥部，最重要的东西放在这里。"
 },
 {
  "id": "mc.card.plan",
  "role": "narrator",
  "text": "下棋前摆阵，就像出发前先做计划。"
 },
 {
  "id": "mc.card.referee",
  "role": "narrator",
  "text": "暗棋要有裁判：裁判只说结果，不说秘密。"
 },
 {
  "id": "mc.card.mountain",
  "role": "narrator",
  "text": "山界只有三个路口，就像大山里只有几条路。"
 },
 {
  "id": "mc.card.bomb",
  "role": "narrator",
  "text": "棋里的炸弹是棋子。生活里看到奇怪的东西，要告诉大人。"
 },
 {
  "id": "mc.card.mine",
  "role": "narrator",
  "text": "地雷在棋里守着军旗，只有工兵能挖开。"
 },
 {
  "id": "mc.card.family",
  "role": "narrator",
  "text": "陆战棋是很多中国家庭都会下的棋。"
 },
 {
  "id": "mc.card.fair",
  "role": "narrator",
  "text": "下棋守规矩：不偷看，输赢都握握手。"
 },
