# 复制成 .env 再填写:   cp .env.example .env && chmod 600 .env
# .env 里有开通码, 绝不进 git(.gitignore 已排除), 也不要发到聊天里。

# 基础镜像, 请钉摘要(RUNBOOK 2.3):  docker buildx imagetools inspect node:22-slim   取 Digest 那行
#   写成  NODE_IMAGE=node:22-slim@sha256:<64位十六进制>
NODE_IMAGE=node:22-slim

# 开通码: >= 12 位随机。生成:  openssl rand -base64 12    (只存在这里; 孩子的设备开通成功后可换新码)
KG_ENROLL_CODE=

# 允许访问的网页来源(逗号分隔, 不能写 *): 正式站 + 预览站, 例如  https://你的游戏域名,https://预览域名
KG_ORIGINS=

# 开通截止时间(Unix 秒; 0=不设限)。建议开通完立刻改成一个已过去的时间, 或换一个新的开通码
KG_ENROLL_OPEN_UNTIL=0

# 反向代理: 1=信任 Caddy 传来的真实来源 IP(只认下面网段内的对端); 必须显式写 0 或 1
KG_TRUST_PROXY=1
KG_PROXY_CIDR=172.30.77.0/24

# 只在本机调试时才设 1
KG_ALLOW_LOCALHOST=0

# 只限爸爸自家的家庭数量
KG_MAX_FAMILIES=3

# 磁盘守卫: 剩余空间低于它(MB)就拒绝写入。共用系统盘时 3072; 如果给 data/ 单独挂了 512 MB 的回环文件系统(RUNBOOK 2.4), 必须改成 64
KG_MIN_FREE_MB=3072
KG_DB_MAX_MB=100

# 备份目录(容器内路径, 对应宿主机的 data/backup)
KG_BACKUP_DIR=/data/backup

# 下面两项只给 ensure-net.sh / RUNBOOK 的命令用, 容器本身不读:
# 生产 Caddy 容器的名字(docker ps --format '{{.Names}}' 能看到)
CADDY_CONTAINER=
